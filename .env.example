# SentinelVision Deployment & Local Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

SENTINEL_RTSP_EMAIL=your_camera_grid_email@example.com
SENTINEL_RTSP_PASSWORD=your_camera_grid_password

SENTINELVISION_DB_PATH=data/sentinelvision.db

# Access Code & Authentication Configuration
SENTINEL_ACCESS_CODE=your_production_access_code_here
SENTINEL_AUTH_REQUIRED=true
SENTINEL_JWT_SECRET=change_this_to_a_secure_random_secret_in_production

# CORS Configuration
SENTINEL_FRONTEND_ORIGIN=https://your-frontend-domain.vercel.app
SENTINELVISION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional RBAC User Credentials Overrides
SENTINEL_ADMIN_USERNAME=admin
SENTINEL_ADMIN_PASSWORD=your_admin_password

SENTINEL_OPERATOR_USERNAME=operator
SENTINEL_OPERATOR_PASSWORD=your_operator_password

SENTINEL_VIEWER_USERNAME=viewer
SENTINEL_VIEWER_PASSWORD=your_viewer_password
