# SentinelVision local configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

SENTINEL_RTSP_EMAIL=
SENTINEL_RTSP_PASSWORD=

SENTINELVISION_DB_PATH=data/sentinelvision.db

# Phase 9.14: Security & Authentication Configuration
SENTINEL_AUTH_REQUIRED=false
SENTINEL_JWT_SECRET=change_this_to_a_secure_random_secret_in_production
SENTINELVISION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SENTINEL_ADMIN_USERNAME=admin
SENTINEL_ADMIN_PASSWORD=

SENTINEL_OPERATOR_USERNAME=operator
SENTINEL_OPERATOR_PASSWORD=

SENTINEL_VIEWER_USERNAME=viewer
SENTINEL_VIEWER_PASSWORD=

